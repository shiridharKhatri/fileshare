# Application
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/filesharing

# JWT Secret for Session Cookies (Change this in production)
JWT_SECRET=your-secure-random-secret-key-at-least-32-chars

# Storage Settings (Local VPS Filesystem)
UPLOAD_DIR=./storage
MAX_FILE_SIZE_MB=5000
MAX_FILES_PER_ROOM=100
MAX_ROOM_STORAGE_MB=10000

# Room Expiration Defaults
DEFAULT_ROOM_EXPIRATION_HOURS=18
CLEANUP_INTERVAL_MINUTES=15

# Rate Limiting
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000
